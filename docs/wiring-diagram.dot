digraph wiring {
  rankdir=LR;
  bgcolor="white";
  graph [fontname="Helvetica", labelloc="t", fontsize=18,
         label="Pump Controller Wiring  —  ESP32 Dev Module, 2 relay channels, start/stop buttons",
         nodesep=0.5, ranksep=1.3, pad=0.4];
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=11, penwidth=2.2, arrowsize=0.8];

  // ---------- Buttons (left) ----------
  SA [shape=box style="rounded,filled" fillcolor="#eef4fb" label="Start A\n(NO, momentary)"];
  PA [shape=box style="rounded,filled" fillcolor="#eef4fb" label="Stop A\n(NC, momentary)"];
  SB [shape=box style="rounded,filled" fillcolor="#eef4fb" label="Start B\n(NO, momentary)"];
  PB [shape=box style="rounded,filled" fillcolor="#eef4fb" label="Stop B\n(NC, momentary)"];

  // ---------- ESP32 ----------
  ESP [shape=plaintext label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="1" BGCOLOR="#2a6fb0"><FONT COLOR="white"><B>ESP32 Dev Module</B></FONT></TD></TR>
      <TR><TD PORT="g32" ALIGN="LEFT">GPIO32 &#8212; Start A</TD></TR>
      <TR><TD PORT="g33" ALIGN="LEFT">GPIO33 &#8212; Stop A</TD></TR>
      <TR><TD PORT="g27" ALIGN="LEFT">GPIO27 &#8212; Start B</TD></TR>
      <TR><TD PORT="g14" ALIGN="LEFT">GPIO14 &#8212; Stop B</TD></TR>
      <TR><TD PORT="g25" ALIGN="LEFT">GPIO25 &#8212; Relay IN1</TD></TR>
      <TR><TD PORT="g26" ALIGN="LEFT">GPIO26 &#8212; Relay IN2</TD></TR>
      <TR><TD PORT="v33" ALIGN="LEFT">3V3</TD></TR>
      <TR><TD PORT="gnd" ALIGN="LEFT">GND</TD></TR>
    </TABLE>>];

  // ---------- Relay module ----------
  RELAY [shape=plaintext label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="1" BGCOLOR="#555555"><FONT COLOR="white"><B>4-Ch Opto Relay (ch1&#8211;2 used)</B></FONT></TD></TR>
      <TR><TD PORT="vcc" ALIGN="LEFT">VCC  (opto logic)</TD></TR>
      <TR><TD PORT="jd" ALIGN="LEFT">JD-VCC  (coils, jumper OFF)</TD></TR>
      <TR><TD PORT="gnd" ALIGN="LEFT">GND</TD></TR>
      <TR><TD PORT="in1" ALIGN="LEFT">IN1  (active-LOW)</TD></TR>
      <TR><TD PORT="in2" ALIGN="LEFT">IN2  (active-LOW)</TD></TR>
      <TR><TD PORT="ch1" ALIGN="LEFT">CH1  COM / NO</TD></TR>
      <TR><TD PORT="ch2" ALIGN="LEFT">CH2  COM / NO</TD></TR>
    </TABLE>>];

  // ---------- Power + ground ----------
  SUP [shape=plaintext label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="2" BGCOLOR="#e08000"><FONT COLOR="white"><B>External 5V supply (&#8805;0.5A)</B></FONT></TD></TR>
      <TR><TD PORT="p5" ALIGN="LEFT">+5V</TD><TD PORT="g" ALIGN="LEFT">GND</TD></TR>
    </TABLE>>];
  GND [shape=box style="rounded,filled" fillcolor="#eeeeee" label="GND\n(common / shared)"];

  // ---------- Contactor coils (right) ----------
  COILA [shape=box style="rounded,filled" fillcolor="#f4ecfa" label="Contactor A coil\n(NO in series,\noverload hardwired)"];
  COILB [shape=box style="rounded,filled" fillcolor="#f4ecfa" label="Contactor B coil\n(NO in series,\noverload hardwired)"];

  // ---------- Nets ----------
  // buttons -> ESP (sense) and -> GND
  SA:e -> ESP:g32 [color="#2a6fb0"];
  PA:e -> ESP:g33 [color="#2a6fb0"];
  SB:e -> ESP:g27 [color="#2a6fb0"];
  PB:e -> ESP:g14 [color="#2a6fb0"];
  SA -> GND [color="#555555"];
  PA -> GND [color="#555555"];
  SB -> GND [color="#555555"];
  PB -> GND [color="#555555"];

  // ESP -> relay: power + signals
  ESP:v33 -> RELAY:vcc [color="#cc3333" label="3.3V"];
  ESP:g25 -> RELAY:in1 [color="#2a6fb0" label="IN1"];
  ESP:g26 -> RELAY:in2 [color="#2a6fb0" label="IN2"];
  ESP:gnd -> GND [color="#555555"];

  // 5V supply
  SUP:p5 -> RELAY:jd [color="#e08000" label="5V"];
  SUP:g -> GND [color="#555555"];
  RELAY:gnd -> GND [color="#555555"];

  // relay contacts -> coils
  RELAY:ch1 -> COILA [color="#7a3fa0" label="COM/NO"];
  RELAY:ch2 -> COILB [color="#7a3fa0" label="COM/NO"];

  // ---------- Legend ----------
  LEGEND [shape=plaintext label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3">
      <TR><TD ALIGN="LEFT"><B>Wire colours</B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#cc3333"><B>&#9644;</B></FONT> 3.3 V (logic / relay VCC)</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#e08000"><B>&#9644;</B></FONT> 5 V (relay coils / JD-VCC)</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fb0"><B>&#9644;</B></FONT> GPIO signal (IN, button sense)</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555"><B>&#9644;</B></FONT> GND (common)</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#7a3fa0"><B>&#9644;</B></FONT> Contactor coil &#8212; mains, electrician</TD></TR>
    </TABLE>>];
}
